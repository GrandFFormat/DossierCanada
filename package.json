{
  "name": "veille-assnat",
  "version": "0.1.0",
  "private": true,
  "description": "Scrapers pour la veille citoyenne de l'Assemblée nationale du Québec",
  "type": "module",
  "scripts": {
    "explore": "node scripts/explore-sources.js",
    "scrape:bills": "node scrapers/bills.js",
    "scrape:bill-details": "node scrapers/bill-details.js",
    "scrape:bill-summaries": "node scrapers/bill-summaries.js",
    "scrape:bill-ai-summaries": "node scrapers/bill-ai-summaries.js",
    "build:frontend": "node scrapers/build-frontend-data.js",
    "scrape:depute-emails": "node scrapers/depute-emails.js",
    "build:depute-emails": "node scrapers/build-depute-emails-data.js",
    "scrape:deputes": "node scrapers/deputes.js",
    "build:deputes": "node scrapers/build-deputes-data.js",
    "scrape:votes": "node scrapers/votes.js",
    "build:votes": "node scrapers/build-votes-data.js",
    "scrape:ministers": "node scrapers/ministers.js",
    "scrape:petitions": "node scrapers/petitions.js",
    "scrape:senators": "node scrapers/senators.js",
    "scrape:senate-votes": "node scrapers/senate-votes.js",
    "scrape:house-calendar": "node scrapers/house-calendar.js",
    "scrape:officeholders": "node scrapers/officeholders.js",
    "build:ministers": "node scrapers/build-ministers-data.js",
    "refresh": "npm run scrape:bills && npm run scrape:bill-summaries && npm run scrape:bill-ai-summaries && npm run scrape:deputes && npm run scrape:depute-emails && npm run scrape:votes && npm run scrape:ministers && npm run scrape:petitions && npm run scrape:senators && npm run scrape:senate-votes && npm run scrape:house-calendar && npm run scrape:officeholders && npm run build:frontend"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "cheerio": "^1.0.0",
    "csv-parse": "^5.6.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}

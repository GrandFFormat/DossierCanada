{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(data|scrapers|scripts|\\.claude)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/data/(site-data|d-bills|d-people|d-votes).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/votes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/weekly-digest",
      "schedule": "0 13 * * 1"
    }
  ],
  "functions": {
    "api/weekly-digest.js": {
      "includeFiles": "data/bills.json"
    }
  },
  "redirects": [
    {
      "source": "/en/deputes",
      "destination": "/en/mps",
      "permanent": true
    },
    {
      "source": "/en/ministres",
      "destination": "/en/ministers",
      "permanent": true
    },
    {
      "source": "/en/projets-de-loi",
      "destination": "/en/bills",
      "permanent": true
    },
    {
      "source": "/en/lexique",
      "destination": "/en/glossary",
      "permanent": true
    },
    {
      "source": "/en/mises-a-jour",
      "destination": "/en/updates",
      "permanent": true
    }
  ]
}

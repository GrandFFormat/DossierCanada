{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/weekly-digest",
      "schedule": "0 13 * * 1"
    }
  ],
  "functions": {
    "api/weekly-digest.js": {
      "includeFiles": "data/bills.json"
    }
  },
  "headers": [
    {
      "source": "/villedemontreal/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/villedemontreal",
      "destination": "/villedemontreal/",
      "permanent": true
    }
  ]
}
